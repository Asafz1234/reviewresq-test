{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "target": "prod",
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/ask-reviews.html",
        "destination": "/pages/ask-reviews.html",
        "type": 302
      }
    ],
    "rewrites": [
      { "source": "/r/**", "destination": "/pages/portal.html" },
      { "source": "/portal", "destination": "/pages/portal.html" },
      { "source": "/portal/**", "destination": "/pages/portal.html" },
      { "source": "/customers", "destination": "/customers.html" },
      { "source": "/customers/**", "destination": "/customers.html" },
      { "source": "/feedback", "destination": "/feedback.html" },
      { "source": "/feedback/**", "destination": "/feedback.html" },
      { "source": "/pages/feedback", "destination": "/feedback.html" },
      { "source": "/pages/feedback.html", "destination": "/feedback.html" },
      { "source": "/pages/feedback/**", "destination": "/feedback.html" },
      { "source": "/google-reviews.html", "destination": "/pages/google-reviews.html" },
      { "source": "/portal.html", "destination": "/pages/portal.html" },
      { "source": "/googleAuthGetConfigV2", "function": "googleAuthGetConfigV2" },
      { "source": "/googleAuthCreateStateV2", "function": "googleAuthCreateStateV2" },
      { "source": "/googlePlacesSearch", "function": "googlePlacesSearch" },
      { "source": "/googlePlacesSearch2", "function": "googlePlacesSearch2" },
      { "source": "/api/sendReviewRequestEmail", "function": "sendReviewRequestEmailHttp" },
      { "source": "/api/createInviteToken", "function": "createInviteTokenHttp" },
      { "source": "/api/sendgrid/events", "function": "sendgridEvents" },
      { "source": "/api/resolveInviteToken", "function": "resolveInviteToken" },
      { "source": "/api/submitPortalFeedback", "function": "submitPortalFeedback" },
      { "source": "/api/recordReviewLinkClick", "function": "recordReviewLinkClick" }
    ]
  }
}
