rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🚩 SECURITY LEVEL: DEVELOPMENT / MVP
    // TODO: BEFORE GLOBAL LAUNCH -> Restrict read/write to specific document owners only.
    // Currently allowing all authenticated users to facilitate testing.
    
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}