
# This file is for local development with the Firebase Emulator Suite.
# Rename this file to .env and fill in your actual secret values.
# IMPORTANT: DO NOT commit the .env file with your real secrets to version control.

# -- Google Cloud / Firebase --
# For connecting to Google Business Profile via OAuth
# Set these as secrets in production: firebase functions:secrets:set ...
GOOGLE_OAUTH_CLIENT_ID="your-google-cloud-oauth-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-cloud-oauth-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:5000/oauth-callback"

# For using the Google Places API
# Set as a secret in production: firebase functions:secrets:set GOOGLE_PLACES_API_KEY
GOOGLE_PLACES_API_KEY="your-google-places-api-key"

# -- SendGrid --
# For sending emails (review requests, notifications)
# Set these as secrets in production: firebase functions:secrets:set ...
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_SENDER="you@yourdomain.com"

# For verifying incoming webhooks from SendGrid
SENDGRID_WEBHOOK_SECRET="your-sendgrid-webhook-shared-secret"
SENDGRID_WEBHOOK_PUBLIC_KEY="your-sendgrid-webhook-verification-key"


# -- OpenAI --
# For AI-powered features
# Set as a secret in production: firebase functions:secrets:set OPENAI_API_KEY
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4.1-mini"

# -- Application Specific --
# A secret token to secure the customer webhook endpoint
CUSTOMER_WEBHOOK_TOKEN="a-strong-random-secret-token"

# Base URL of your web app for generating links in emails/SMS
APP_BASE_URL="https://reviewresq.com"

# Set to "true" to enable test mode behaviors
REVIEWRESQ_TEST_MODE="false"

